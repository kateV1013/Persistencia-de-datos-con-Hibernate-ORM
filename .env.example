# ============================================================
#  Variables de entorno para Quilate ERP – Conexión PostgreSQL
#  COPIA este archivo como .env y NO lo subas al repositorio.
#  Agregar .env al .gitignore.
# ============================================================

# Usuario de PostgreSQL
DB_USER=postgres

# Contraseña de PostgreSQL
DB_PASS=tu_contraseña_aqui

# Host donde corre PostgreSQL (localhost para desarrollo local)
DB_HOST=localhost

# Puerto de PostgreSQL (default: 5432)
DB_PORT=5432

# Nombre de la base de datos vacía que debes crear en PostgreSQL
# Ejecuta: CREATE DATABASE quilate_db;
DB_NAME=quilate_db
