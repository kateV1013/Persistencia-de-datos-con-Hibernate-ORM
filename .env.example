# Copia estas variables a la configuracion de ejecucion de IntelliJ.
# No subas el archivo .env real.
DB_URL=jdbc:postgresql://localhost:5432/quilate
DB_USER=quilate_app
DB_PASSWORD=cambiar_localmente

# Alternativa compatible si no se define DB_URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=quilate
# DB_PASS=cambiar_localmente
