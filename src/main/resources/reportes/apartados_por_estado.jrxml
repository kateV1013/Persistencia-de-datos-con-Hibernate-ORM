<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="apartados_por_estado" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="NoPages">
	<style name="Base" isDefault="true" fontName="Open Sans" fontSize="9" forecolor="#3E2C2A"/>
	<style name="Marca" fontName="Open Sans" fontSize="10" isBold="true" forecolor="#8C6A60"/>
	<style name="Titulo" fontName="Open Sans" fontSize="15" isBold="true" forecolor="#3E2C2A"/>
	<style name="Subtitulo" fontName="Open Sans" fontSize="9" forecolor="#7A6A66"/>
	<style name="Columna" mode="Opaque" backcolor="#4A3B38" forecolor="#FFFFFF" fontName="Open Sans" fontSize="8" isBold="true" vTextAlign="Middle"/>
	<style name="Grupo" mode="Opaque" backcolor="#EFE7E2" forecolor="#3E2C2A" fontName="Open Sans" fontSize="9" isBold="true" vTextAlign="Middle"/>
	<style name="Total" fontName="Open Sans" fontSize="9" isBold="true" forecolor="#3E2C2A" vTextAlign="Middle"/>
	<style name="Etiqueta" fontName="Open Sans" fontSize="8" isBold="true" forecolor="#8C6A60" vTextAlign="Middle"/>
	<parameter name="p_desde" class="java.sql.Timestamp"/>
	<parameter name="p_hasta" class="java.sql.Timestamp"/>
	<parameter name="p_periodo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT a.estado, a.id, a.fecha, TRIM(CONCAT(c.nombre, ' ', COALESCE(c.apellido, ''))) AS cliente, p.nombre AS pieza, a.cantidad
FROM apartado a
JOIN cliente c ON c.id_cliente = a.cliente_id
JOIN piezas p ON p.id = a.pieza_id
WHERE a.fecha >= $P{p_desde} AND a.fecha < $P{p_hasta}
ORDER BY a.estado, a.fecha, a.id]]>
	</queryString>
	<field name="estado" class="java.lang.String"/>
	<field name="id" class="java.lang.Long"/>
	<field name="fecha" class="java.sql.Timestamp"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="pieza" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<group name="estado">
		<groupExpression><![CDATA[$F{estado}]]></groupExpression>
		<groupHeader>
			<band height="22" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement style="Grupo" x="0" y="2" width="535" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[($F{estado} == null ? null : $F{estado}.substring(0, 1) + $F{estado}.substring(1).toLowerCase().replace("_", " "))]]></textFieldExpression>
			</textField>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="22" splitType="Stretch">
			<textField>
				<reportElement style="Total" x="0" y="0" width="535" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$V{estado_COUNT} + " apartado(s)"]]></textFieldExpression>
			</textField>
			</band>
		</groupFooter>
	</group>
	<title>
		<band height="66" splitType="Stretch">
			<staticText>
				<reportElement style="Marca" x="0" y="0" width="535" height="16"/>
				<text><![CDATA[JOYERÍA QUILATE - MANAGUA]]></text>
			</staticText>
			<textField>
				<reportElement style="Titulo" x="0" y="18" width="535" height="22"/>
				<textFieldExpression><![CDATA["Apartados por estado"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Subtitulo" x="0" y="40" width="535" height="14"/>
				<textFieldExpression><![CDATA[$P{p_periodo} + " · Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="60" width="535" height="1" forecolor="#BA9A90"/>
			</line>
		</band>
	</title>
	<columnHeader>
		<band height="20" splitType="Stretch">
			<staticText>
				<reportElement style="Columna" x="0" y="0" width="90" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[Fecha]]></text>
			</staticText>
			<staticText>
				<reportElement style="Columna" x="90" y="0" width="70" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[N.º]]></text>
			</staticText>
			<staticText>
				<reportElement style="Columna" x="160" y="0" width="170" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[Cliente]]></text>
			</staticText>
			<staticText>
				<reportElement style="Columna" x="330" y="0" width="160" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[Pieza]]></text>
			</staticText>
			<staticText>
				<reportElement style="Columna" x="490" y="0" width="45" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<text><![CDATA[Cant.]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="18" splitType="Stretch">
			<frame>
				<reportElement mode="Opaque" x="0" y="0" width="535" height="18" backcolor="#F8F4F1">
					<printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
				</reportElement>
			</frame>
			<textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
				<reportElement x="0" y="0" width="90" height="18"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="90" y="0" width="70" height="18"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="160" y="0" width="170" height="18"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="330" y="0" width="160" height="18"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{pieza}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="490" y="0" width="45" height="18"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="20" splitType="Stretch">
			<textField>
				<reportElement style="Subtitulo" x="335" y="4" width="160" height="14"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement style="Subtitulo" x="495" y="4" width="40" height="14"/>
				<textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band height="26" splitType="Stretch">
			<textField>
				<reportElement style="Total" x="0" y="0" width="535" height="26"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA["Total: " + $V{REPORT_COUNT} + " apartado(s) en el período"]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
