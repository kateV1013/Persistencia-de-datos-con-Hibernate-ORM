<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pedidos_agenda_semanal" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="NoPages">
	<style name="Base" isDefault="true" fontName="Open Sans" fontSize="9" forecolor="#3E2C2A"/>
	<style name="Marca" fontName="Open Sans" fontSize="10" isBold="true" forecolor="#8C6A60"/>
	<style name="Titulo" fontName="Open Sans" fontSize="15" isBold="true" forecolor="#3E2C2A"/>
	<style name="Subtitulo" fontName="Open Sans" fontSize="9" forecolor="#7A6A66"/>
	<style name="Columna" mode="Opaque" backcolor="#4A3B38" forecolor="#FFFFFF" fontName="Open Sans" fontSize="8" isBold="true" vTextAlign="Middle"/>
	<style name="Grupo" mode="Opaque" backcolor="#EFE7E2" forecolor="#3E2C2A" fontName="Open Sans" fontSize="9" isBold="true" vTextAlign="Middle"/>
	<style name="Total" fontName="Open Sans" fontSize="9" isBold="true" forecolor="#3E2C2A" vTextAlign="Middle"/>
	<style name="Etiqueta" fontName="Open Sans" fontSize="8" isBold="true" forecolor="#8C6A60" vTextAlign="Middle"/>
	<parameter name="p_simbolo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C$"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tasa" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[java.math.BigDecimal.ONE]]></defaultValueExpression>
	</parameter>
	<parameter name="p_fecha_desde" class="java.sql.Date"/>
	<parameter name="p_fecha_hasta" class="java.sql.Date"/>
	<parameter name="p_periodo" class="java.lang.String"/>
	<parameter name="p_cupo" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[com.quilate.service.PedidoService.CUPO_SEMANAL]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT pe.id_pedido, pe.fecha_programada, TRIM(CONCAT(c.nombre, ' ', COALESCE(c.apellido, ''))) AS cliente, ts.nombre AS servicio,
       pe.descripcion_trabajo, pe.estado, pe.precio
FROM pedido_personalizado pe
JOIN cliente c ON c.id_cliente = pe.id_cliente
JOIN tipo_servicio ts ON ts.id_tipo_servicio = pe.id_tipo_servicio
WHERE pe.estado <> 'CANCELADO'
  AND pe.fecha_programada >= $P{p_fecha_desde} AND pe.fecha_programada <= $P{p_fecha_hasta}
ORDER BY pe.fecha_programada, pe.id_pedido]]>
	</queryString>
	<field name="id_pedido" class="java.lang.Integer"/>
	<field name="fecha_programada" class="java.sql.Date"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="servicio" class="java.lang.String"/>
	<field name="descripcion_trabajo" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="precio" class="java.math.BigDecimal"/>
	<group name="dia">
		<groupExpression><![CDATA[$F{fecha_programada}]]></groupExpression>
		<groupHeader>
			<band height="22" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement style="Grupo" x="0" y="2" width="535" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[new java.text.SimpleDateFormat("EEEE dd/MM/yyyy", new java.util.Locale("es", "NI")).format($F{fecha_programada})]]></textFieldExpression>
			</textField>
			</band>
		</groupHeader>
	</group>
	<title>
		<band height="66" splitType="Stretch">
			<staticText>
				<reportElement style="Marca" x="0" y="0" width="535" height="16"/>
				<text><![CDATA[JOYERÍA QUILATE - MANAGUA]]></text>
			</staticText>
			<textField>
				<reportElement style="Titulo" x="0" y="18" width="535" height="22"/>
				<textFieldExpression><![CDATA["Agenda semanal del taller"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Subtitulo" x="0" y="40" width="535" height="14"/>
				<textFieldExpression><![CDATA[$P{p_periodo} + " · Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="60" width="535" height="1" forecolor="#BA9A90"/>
			</line>
		</band>
	</title>
	<columnHeader>
		<band height="20" splitType="Stretch">
			<staticText>
				<reportElement style="Columna" x="0" y="0" width="35" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[N.º]]></text>
			</staticText>
			<staticText>
				<reportElement style="Columna" x="35" y="0" width="115" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[Cliente]]></text>
			</staticText>
			<staticText>
				<reportElement style="Columna" x="150" y="0" width="95" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[Servicio]]></text>
			</staticText>
			<staticText>
				<reportElement style="Columna" x="245" y="0" width="155" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[Trabajo]]></text>
			</staticText>
			<staticText>
				<reportElement style="Columna" x="400" y="0" width="60" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[Estado]]></text>
			</staticText>
			<staticText>
				<reportElement style="Columna" x="460" y="0" width="75" height="20"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<text><![CDATA[Precio]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="18" splitType="Stretch">
			<frame>
				<reportElement mode="Opaque" x="0" y="0" width="535" height="18" backcolor="#F8F4F1">
					<printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
				</reportElement>
			</frame>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="35" height="18"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{id_pedido}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="35" y="0" width="115" height="18"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="150" y="0" width="95" height="18"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{servicio}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="245" y="0" width="155" height="18"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{descripcion_trabajo}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="400" y="0" width="60" height="18"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[($F{estado} == null ? null : $F{estado}.substring(0, 1) + $F{estado}.substring(1).toLowerCase().replace("_", " "))]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="460" y="0" width="75" height="18"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[com.quilate.util.ReporteUtil.monto($F{precio}, $P{p_tasa})]]></textFieldExpression>
				<patternExpression><![CDATA[$P{p_simbolo} + " #,##0.00"]]></patternExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="20" splitType="Stretch">
			<textField>
				<reportElement style="Subtitulo" x="0" y="4" width="330" height="14"/>
				<textFieldExpression><![CDATA["US$".equals($P{p_simbolo}) ? "Importes en dólares · tasa C$ " + $P{p_tasa}.stripTrailingZeros().toPlainString() + " por US$ 1" : "Importes en córdobas (C$)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Subtitulo" x="335" y="4" width="160" height="14"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement style="Subtitulo" x="495" y="4" width="40" height="14"/>
				<textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band height="26" splitType="Stretch">
			<textField>
				<reportElement style="Total" x="0" y="0" width="535" height="26"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$V{REPORT_COUNT} + " de " + $P{p_cupo} + " pedidos de la semana"]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
