<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pedidos_orden_trabajo" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="NoPages">
	<style name="Base" isDefault="true" fontName="Open Sans" fontSize="9" forecolor="#3E2C2A"/>
	<style name="Marca" fontName="Open Sans" fontSize="10" isBold="true" forecolor="#8C6A60"/>
	<style name="Titulo" fontName="Open Sans" fontSize="15" isBold="true" forecolor="#3E2C2A"/>
	<style name="Subtitulo" fontName="Open Sans" fontSize="9" forecolor="#7A6A66"/>
	<style name="Columna" mode="Opaque" backcolor="#4A3B38" forecolor="#FFFFFF" fontName="Open Sans" fontSize="8" isBold="true" vTextAlign="Middle"/>
	<style name="Grupo" mode="Opaque" backcolor="#EFE7E2" forecolor="#3E2C2A" fontName="Open Sans" fontSize="9" isBold="true" vTextAlign="Middle"/>
	<style name="Total" fontName="Open Sans" fontSize="9" isBold="true" forecolor="#3E2C2A" vTextAlign="Middle"/>
	<style name="Etiqueta" fontName="Open Sans" fontSize="8" isBold="true" forecolor="#8C6A60" vTextAlign="Middle"/>
	<parameter name="p_simbolo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C$"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tasa" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[java.math.BigDecimal.ONE]]></defaultValueExpression>
	</parameter>
	<parameter name="p_pedido_id" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT pe.id_pedido, TRIM(CONCAT(c.nombre, ' ', COALESCE(c.apellido, ''))) AS cliente, c.telefono, ts.nombre AS servicio, pe.fecha_programada,
       pe.estado, pe.precio, pe.descripcion_trabajo, pe.diseno_texto, pe.diseno_forma, pe.diseno_acabado,
       pe.diseno_fuente, pe.diseno_medida_mm, pe.diseno_ancho_mm, pe.diseno_letra_mm
FROM pedido_personalizado pe
JOIN cliente c ON c.id_cliente = pe.id_cliente
JOIN tipo_servicio ts ON ts.id_tipo_servicio = pe.id_tipo_servicio
WHERE pe.id_pedido = $P{p_pedido_id}]]>
	</queryString>
	<field name="id_pedido" class="java.lang.Integer"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="servicio" class="java.lang.String"/>
	<field name="fecha_programada" class="java.sql.Date"/>
	<field name="estado" class="java.lang.String"/>
	<field name="precio" class="java.math.BigDecimal"/>
	<field name="descripcion_trabajo" class="java.lang.String"/>
	<field name="diseno_texto" class="java.lang.String"/>
	<field name="diseno_forma" class="java.lang.String"/>
	<field name="diseno_acabado" class="java.lang.String"/>
	<field name="diseno_fuente" class="java.lang.String"/>
	<field name="diseno_medida_mm" class="java.math.BigDecimal"/>
	<field name="diseno_ancho_mm" class="java.math.BigDecimal"/>
	<field name="diseno_letra_mm" class="java.math.BigDecimal"/>
	<title>
		<band height="66" splitType="Stretch">
			<staticText>
				<reportElement style="Marca" x="0" y="0" width="535" height="16"/>
				<text><![CDATA[JOYERÍA QUILATE - MANAGUA]]></text>
			</staticText>
			<textField>
				<reportElement style="Titulo" x="0" y="18" width="535" height="22"/>
				<textFieldExpression><![CDATA["Orden de trabajo N.º " + $F{id_pedido}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Subtitulo" x="0" y="40" width="535" height="14"/>
				<textFieldExpression><![CDATA["Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="60" width="535" height="1" forecolor="#BA9A90"/>
			</line>
		</band>
	</title>
	<detail>
		<band height="302" splitType="Stretch">
			<staticText>
				<reportElement style="Etiqueta" x="0" y="0" width="170" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[PEDIDO N.º]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="170" y="0" width="365" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{id_pedido}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="24" width="170" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[CLIENTE]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="170" y="24" width="365" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="48" width="170" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[TELÉFONO]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="170" y="48" width="365" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="72" width="170" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[SERVICIO]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="170" y="72" width="365" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{servicio}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="96" width="170" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[FECHA PROGRAMADA]]></text>
			</staticText>
			<textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
				<reportElement x="170" y="96" width="365" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{fecha_programada}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="120" width="170" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[ESTADO]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="170" y="120" width="365" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[($F{estado} == null ? null : $F{estado}.substring(0, 1) + $F{estado}.substring(1).toLowerCase().replace("_", " "))]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="144" width="170" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[PRECIO]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="170" y="144" width="365" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[com.quilate.util.ReporteUtil.monto($F{precio}, $P{p_tasa})]]></textFieldExpression>
				<patternExpression><![CDATA[$P{p_simbolo} + " #,##0.00"]]></patternExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="168" width="170" height="60"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[TRABAJO]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="170" y="168" width="365" height="60"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{descripcion_trabajo}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="230" width="170" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[DISEÑO]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="170" y="230" width="365" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[($F{diseno_forma} == null ? "Sin diseño guardado" : $F{diseno_forma} + " · " + $F{diseno_acabado} + " · fuente " + $F{diseno_fuente})]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="254" width="170" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[GRABADO]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="170" y="254" width="365" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[($F{diseno_forma} == null ? null : ($F{diseno_texto} == null || $F{diseno_texto}.isEmpty() ? "Sin texto" : "«" + $F{diseno_texto} + "»"))]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="278" width="170" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[MEDIDAS]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="170" y="278" width="365" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[($F{diseno_forma} == null ? null : $F{diseno_medida_mm} + " × " + $F{diseno_ancho_mm} + " mm · letra " + $F{diseno_letra_mm} + " mm")]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="20" splitType="Stretch">
			<textField>
				<reportElement style="Subtitulo" x="0" y="4" width="330" height="14"/>
				<textFieldExpression><![CDATA["US$".equals($P{p_simbolo}) ? "Importes en dólares · tasa C$ " + $P{p_tasa}.stripTrailingZeros().toPlainString() + " por US$ 1" : "Importes en córdobas (C$)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Subtitulo" x="335" y="4" width="160" height="14"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement style="Subtitulo" x="495" y="4" width="40" height="14"/>
				<textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
