<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="inventario_ficha_pieza" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="NoPages">
	<style name="Base" isDefault="true" fontName="Open Sans" fontSize="9" forecolor="#3E2C2A"/>
	<style name="Marca" fontName="Open Sans" fontSize="10" isBold="true" forecolor="#8C6A60"/>
	<style name="Titulo" fontName="Open Sans" fontSize="15" isBold="true" forecolor="#3E2C2A"/>
	<style name="Subtitulo" fontName="Open Sans" fontSize="9" forecolor="#7A6A66"/>
	<style name="Columna" mode="Opaque" backcolor="#4A3B38" forecolor="#FFFFFF" fontName="Open Sans" fontSize="8" isBold="true" vTextAlign="Middle"/>
	<style name="Grupo" mode="Opaque" backcolor="#EFE7E2" forecolor="#3E2C2A" fontName="Open Sans" fontSize="9" isBold="true" vTextAlign="Middle"/>
	<style name="Total" fontName="Open Sans" fontSize="9" isBold="true" forecolor="#3E2C2A" vTextAlign="Middle"/>
	<style name="Etiqueta" fontName="Open Sans" fontSize="8" isBold="true" forecolor="#8C6A60" vTextAlign="Middle"/>
	<parameter name="p_simbolo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C$"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tasa" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[java.math.BigDecimal.ONE]]></defaultValueExpression>
	</parameter>
	<parameter name="p_pieza_id" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[SELECT p.codigo_barras, p.nombre, p.material,
       CAST(p.quilates AS INTEGER) AS quilates, p.peso_gramos,
       p.costo, p.precio_venta, p.existencias,
       p.precio_venta * p.existencias AS valor,
       COALESCE(c.nombre, 'Sin categoría') AS categoria,
       c.descripcion AS categoria_descripcion
FROM piezas p
LEFT JOIN categorias c ON c.id = p.categoria_id
WHERE p.id = $P{p_pieza_id}]]>
	</queryString>
	<field name="codigo_barras" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="material" class="java.lang.String"/>
	<field name="quilates" class="java.lang.Integer"/>
	<field name="peso_gramos" class="java.math.BigDecimal"/>
	<field name="costo" class="java.lang.Double"/>
	<field name="precio_venta" class="java.lang.Double"/>
	<field name="existencias" class="java.lang.Integer"/>
	<field name="valor" class="java.lang.Double"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="categoria_descripcion" class="java.lang.String"/>
	<title>
		<band height="66" splitType="Stretch">
			<staticText>
				<reportElement style="Marca" x="0" y="0" width="535" height="16"/>
				<text><![CDATA[JOYERÍA QUILATE - MANAGUA]]></text>
			</staticText>
			<textField>
				<reportElement style="Titulo" x="0" y="18" width="535" height="22"/>
				<textFieldExpression><![CDATA["Ficha de pieza · " + $F{nombre}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Subtitulo" x="0" y="40" width="535" height="14"/>
				<textFieldExpression><![CDATA["Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="60" width="535" height="1" forecolor="#BA9A90"/>
			</line>
		</band>
	</title>
	<detail>
		<band height="264" splitType="Stretch">
			<staticText>
				<reportElement style="Etiqueta" x="0" y="0" width="180" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[CÓDIGO DE BARRAS]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="0" width="355" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{codigo_barras}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="24" width="180" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[PIEZA]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="24" width="355" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="48" width="180" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[CATEGORÍA]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="48" width="355" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="72" width="180" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[DESCRIPCIÓN DE LA CATEGORÍA]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="72" width="355" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{categoria_descripcion}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="96" width="180" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[MATERIAL]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="96" width="355" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{material}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="120" width="180" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[QUILATES]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="120" width="355" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{quilates} == null ? null : $F{quilates} + " K"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="144" width="180" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[PESO]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="144" width="355" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{peso_gramos} == null ? null : $F{peso_gramos} + " g"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="168" width="180" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[COSTO UNITARIO]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="168" width="355" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[com.quilate.util.ReporteUtil.monto($F{costo}, $P{p_tasa})]]></textFieldExpression>
				<patternExpression><![CDATA[$P{p_simbolo} + " #,##0.00"]]></patternExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="192" width="180" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[PRECIO DE VENTA]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="192" width="355" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[com.quilate.util.ReporteUtil.monto($F{precio_venta}, $P{p_tasa})]]></textFieldExpression>
				<patternExpression><![CDATA[$P{p_simbolo} + " #,##0.00"]]></patternExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="216" width="180" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[EXISTENCIAS]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="216" width="355" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{existencias}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Etiqueta" x="0" y="240" width="180" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[VALOR EN INVENTARIO]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="240" width="355" height="22"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[com.quilate.util.ReporteUtil.monto($F{valor}, $P{p_tasa})]]></textFieldExpression>
				<patternExpression><![CDATA[$P{p_simbolo} + " #,##0.00"]]></patternExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="20" splitType="Stretch">
			<textField>
				<reportElement style="Subtitulo" x="0" y="4" width="330" height="14"/>
				<textFieldExpression><![CDATA["US$".equals($P{p_simbolo}) ? "Importes en dólares · tasa C$ " + $P{p_tasa}.stripTrailingZeros().toPlainString() + " por US$ 1" : "Importes en córdobas (C$)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Subtitulo" x="335" y="4" width="160" height="14"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement style="Subtitulo" x="495" y="4" width="40" height="14"/>
				<textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
