<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.quilate.controller.TipoServicioController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colNombre" text="Servicio" prefWidth="180"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="340"/>
                <TableColumn fx:id="colPrecio" text="Precio base" prefWidth="120"/>
            </columns>
        </TableView>
    </center>

    <right>
        <VBox spacing="8" prefWidth="300" styleClass="formulario">
            <BorderPane.margin><Insets left="12"/></BorderPane.margin>
            <Label text="Tipo de servicio" styleClass="titulo-seccion"/>

            <Label text="Nombre *"/>
            <TextField fx:id="txtNombre" promptText="Ej. Grabado"/>

            <Label text="Descripción"/>
            <TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true"/>

            <Label text="Precio base (C$) *"/>
            <TextField fx:id="txtPrecio" promptText="0.00"/>

            <HBox spacing="8">
                <Button text="Nuevo" onAction="#onNuevo"/>
                <Button text="Guardar" onAction="#onGuardar"/>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" styleClass="peligro"/>
            </HBox>

            <Label fx:id="lblMensaje" wrapText="true" styleClass="mensaje"/>
        </VBox>
    </right>
</BorderPane>
