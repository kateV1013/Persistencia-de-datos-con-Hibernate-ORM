<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.quilate.controller.ApartadosController">
    <center>
        <VBox spacing="12">
            <HBox alignment="CENTER_LEFT">
                <Label text="Reservas de piezas" styleClass="titulo-seccion"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="Consulta las reservas y selecciona una para gestionar su estado." styleClass="ayuda"/>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS"/>
            <Label fx:id="mensaje" wrapText="true" styleClass="mensaje"/>
        </VBox>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="306" minWidth="306">
            <BorderPane.margin>
                <Insets left="18"/>
            </BorderPane.margin>
            <VBox styleClass="formulario" spacing="12">
                <Label text="Detalle de la reserva" styleClass="titulo-seccion"/>
                <Label text="Elige el cliente, la pieza y la cantidad que deseas apartar." wrapText="true" styleClass="ayuda"/>
                <VBox spacing="5">
                    <Label text="CLIENTE *" styleClass="campo-label"/>
                    <ComboBox fx:id="cliente" promptText="Selecciona un cliente" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="PIEZA *" styleClass="campo-label"/>
                    <ComboBox fx:id="pieza" promptText="Selecciona una pieza" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="CANTIDAD *" styleClass="campo-label"/>
                    <TextField fx:id="cantidad" promptText="Cantidad" maxWidth="Infinity" text="1"/>
                </VBox>
                <FlowPane hgap="8" vgap="8">
                    <Button text="Guardar reserva" onAction="#guardar"/>
                    <Button text="Nueva" onAction="#nuevo" styleClass="secundario"/>
                </FlowPane>
                <Separator/>
                <Label text="Gestionar reserva seleccionada" styleClass="campo-label"/>
                <Button text="Convertir en venta" onAction="#vender" styleClass="confirmar"/>
                <Button text="Cancelar reserva" onAction="#cancelar" styleClass="peligro"/>
                <Separator/>
                <Label text="REPORTES" styleClass="campo-label"/>
                <FlowPane hgap="8" vgap="8">
                    <Button text="Activos" onAction="#reporteActivos" styleClass="secundario"/>
                    <Button text="Comprobante" onAction="#reporteComprobante" styleClass="secundario"/>
                    <Button text="Por estado" onAction="#reportePorEstado" styleClass="secundario"/>
                    <Button text="Convertidos en venta" onAction="#reporteConvertidos" styleClass="secundario"/>
                </FlowPane>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
