<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.quilate.controller.ApartadosController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Apartados y reservas de inventario"/>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS"/>
    <FlowPane hgap="8" vgap="8">
        <ComboBox fx:id="cliente" promptText="Cliente" prefWidth="240"/>
        <ComboBox fx:id="pieza" promptText="Pieza" prefWidth="240"/>
        <TextField fx:id="cantidad" promptText="Cantidad" text="1"/>
    </FlowPane>
    <FlowPane hgap="8" vgap="8">
        <Button text="Nuevo" onAction="#nuevo"/>
        <Button text="Guardar reserva" onAction="#guardar"/>
        <Button text="Cancelar reserva" onAction="#cancelar"/>
        <Button text="Convertir en venta" onAction="#vender"/>
        <Button text="Actualizar" onAction="#recargar"/>
    </FlowPane>
    <Label fx:id="mensaje" wrapText="true"/>
</VBox>
