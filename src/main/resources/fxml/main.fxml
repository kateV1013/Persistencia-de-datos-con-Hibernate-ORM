<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!--
    Menu principal. Las tarjetas de los modulos se generan desde el enum
    com.quilate.ui.Modulo y cada una abre su modulo en una ventana nueva.
-->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.quilate.controller.MainController" styleClass="menu-principal">

    <top>
        <HBox styleClass="encabezado">
            <StackPane fx:id="logo" styleClass="logo"/>
            <VBox spacing="2">
                <Label text="Quilate" styleClass="titulo"/>
                <Label text="Sistema de ventas y análisis de clientes para joyería" styleClass="subtitulo"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblFecha" styleClass="fecha"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="menu-scroll">
            <VBox fx:id="contenedorSecciones" styleClass="menu-contenido">
                <Label text="¿Qué deseas hacer hoy?" styleClass="saludo"/>
                <Label text="Elige un módulo; cada uno se abre en su propia ventana."
                       styleClass="saludo-detalle"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="barra-estado">
            <Circle fx:id="indicadorConexion" radius="5" styleClass="indicador"/>
            <Label fx:id="lblEstado"/>
        </HBox>
    </bottom>
</BorderPane>
