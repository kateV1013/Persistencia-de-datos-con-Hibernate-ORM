<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.quilate.controller.MainController">

    <top>
        <HBox styleClass="header">
            <Label text="Quilate" styleClass="titulo"/>
            <Label text="Sistema de Ventas y Analisis de Clientes" styleClass="subtitulo"/>
        </HBox>
    </top>

    <center>
        <!--
            Cada integrante reemplaza el contenido de su pestana por su FXML, por ejemplo:
            <Tab text="Piezas" closable="false"><fx:include source="piezas.fxml"/></Tab>
        -->
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Inventario"><fx:include source="inventario.fxml"/></Tab>
            <Tab text="Clientes"><fx:include source="clientes.fxml"/></Tab>
            <Tab text="Apartados"><fx:include source="apartados.fxml"/></Tab>
            <Tab text="Ventas"><fx:include source="ventas.fxml"/></Tab>
            <!-- Integrante 4: pedidos personalizados y reportes -->
            <Tab text="Pedidos personalizados"><fx:include source="pedidos.fxml"/></Tab>
            <Tab text="Tipos de servicio"><fx:include source="servicios.fxml"/></Tab>
            <Tab text="Piezas más vendidas"><fx:include source="reporte_piezas.fxml"/></Tab>
        </TabPane>
    </center>

    <bottom>
        <HBox styleClass="barra-estado">
            <padding><Insets top="4" right="10" bottom="4" left="10"/></padding>
            <Label fx:id="lblEstado"/>
        </HBox>
    </bottom>
</BorderPane>
