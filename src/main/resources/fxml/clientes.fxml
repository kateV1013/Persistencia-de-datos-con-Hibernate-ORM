<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.quilate.controller.ClientesController">
    <center>
        <VBox spacing="12">
            <HBox alignment="CENTER_LEFT">
                <Label text="Directorio de clientes" styleClass="titulo-seccion"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" onAction="#recargar" styleClass="secundario"/>
            </HBox>
            <Label text="Selecciona un cliente para consultar sus datos y compras." styleClass="ayuda"/>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS" minHeight="150"/>
            <FlowPane hgap="12" vgap="10" styleClass="client-insights">
 <VBox spacing="4" prefWidth="100"><Label text="COMPRAS" styleClass="campo-label"/><Label fx:id="lblPerfilCompras" text="—" styleClass="insight-value"/></VBox>
 <VBox spacing="4" prefWidth="145"><Label text="MONTO COMPRADO" styleClass="campo-label"/><Label fx:id="lblPerfilMonto" text="—" styleClass="insight-value"/></VBox>
 <VBox spacing="4" prefWidth="210"><Label text="DÍAS MÁS FRECUENTES" styleClass="campo-label"/><Label fx:id="lblPerfilDia" text="Selecciona un cliente" wrapText="true"/></VBox>
 <VBox spacing="4" prefWidth="225"><Label text="HORAS MÁS FRECUENTES" styleClass="campo-label"/><Label fx:id="lblPerfilHora" text="Selecciona un cliente" wrapText="true"/></VBox>
</FlowPane>
<Label text="Frecuencia por ventas confirmadas. Se muestran todos los empates." styleClass="ayuda"/>
<Label text="Historial de compras" styleClass="titulo-seccion"/>
            <Label text="Compras confirmadas del cliente seleccionado" styleClass="ayuda"/>
            <TableView fx:id="historial" VBox.vgrow="ALWAYS" minHeight="130"/>
        </VBox>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="306" minWidth="306">
            <BorderPane.margin>
                <Insets left="18"/>
            </BorderPane.margin>
            <VBox styleClass="formulario" spacing="12">
                <Label text="Ficha del cliente" styleClass="titulo-seccion"/>
                <Label text="Crea un registro o edita el cliente seleccionado." styleClass="ayuda" wrapText="true"/>
                <VBox spacing="5">
                    <Label text="NOMBRE *" styleClass="campo-label"/>
                    <TextField fx:id="nombre" promptText="Ej. María" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="APELLIDO *" styleClass="campo-label"/>
                    <TextField fx:id="apellido" promptText="Ej. López" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="TELÉFONO" styleClass="campo-label"/>
                    <TextField fx:id="telefono" promptText="Ej. 8888-8888" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="CORREO ELECTRÓNICO" styleClass="campo-label"/>
                    <TextField fx:id="correo" promptText="nombre@correo.com" maxWidth="Infinity"/>
                </VBox>
                <FlowPane hgap="8" vgap="8">
                    <Button text="Guardar cliente" onAction="#guardar"/>
                    <Button text="Nuevo" onAction="#nuevo" styleClass="secundario"/>
                </FlowPane>
                <Separator/>
                <Button text="Eliminar cliente" onAction="#eliminar" styleClass="peligro"/>
                <Label fx:id="mensaje" styleClass="mensaje" wrapText="true"/>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
